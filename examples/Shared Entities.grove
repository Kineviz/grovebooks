{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"Button(\"Find Shared Entities\", async () => {\n  const sharedEntities = gxr.nodes(\":Entity\").filter((n) => {\n    const hasMessageNeighbor = n.neighbor.some((id) =>\n      id.includes(\"Message::\")\n    );\n    const hasChunkNeighbor = n.neighbor.some((id) => id.startsWith(\"Chunk\"));\n    return hasMessageNeighbor && hasChunkNeighbor;\n  });\n  console.log(sharedEntities.values().map((n) => n.id));\n  sharedEntities.select();\n})","pinCode":false,"dname":"1c6dcc42-cd94-48a2-9d69-8cc0756975fe","codeMode":"javascript2"}}}],"version":"2.19.1"}
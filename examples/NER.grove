{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"md`# Named Entity Recognition`","pinCode":false,"dname":"26cce657-ebe4-4347-9714-75a798ffb933","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof model = Inputs.select([\"gpt-4.1-nano\", \"gpt-4.1-mini\", \"gpt-4.1\"])","pinCode":false,"dname":"ff388950-eb54-48fe-940d-1a3c2d5723e0","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof category = Inputs.select(\n  _.uniq(graph.nodes(\"[[selected]]\").map((n) => n.category)),\n  { label: \"Category\" }\n)","pinCode":false,"dname":"0b095180-a2e5-4d24-b1e1-869570e686ec","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"properties = {\n  const nodes = graph.nodes(\"[[selected]]\").filter((n) => n.selected);\n  if (nodes.length > 0) {\n    return _.uniq(\n      Object.keys(\n        graph\n          .nodes(\"[[selected]]\")\n          .filter((n) => n.selected)\n          .at(0).properties\n      )\n    );\n  } else {\n    return [];\n  }\n}","pinCode":false,"dname":"54feddee-a492-48cb-84fa-2a54e17e8af9","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"viewof property = Inputs.select(properties, { label: \"Property\" })","pinCode":false,"dname":"301cb84a-e9a5-48e4-998c-c58032ca9af5","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof extraInstructions = Inputs.textarea({ label: \"Extra Instructions\" })","pinCode":false,"dname":"4c18f108-3420-41c7-86a0-23486b9be445","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"Button(\"Run\", async () => {\n  const selectedProperty = property;\n  const nodes = gxr\n    .nodes(\"[[selected]]\")\n    .filter((n) => n.category == category)\n    .values();\n  const batchSize = 5;\n  const batchesInFlight = 20;\n  const batches = _.chunk(_.chunk(nodes, batchSize), batchesInFlight);\n  const startTime = Date.now();\n  let percent = 0;\n  let perSecond = 0;\n  let elapsedSeconds = 0;\n  mutable progress = { percent };\n  for (let i = 0; i < batches.length; i++) {\n    const batch = batches[i];\n    console.log(\"Launching\", batch);\n    await Promise.all(batch.map((nodes) => ner(nodes, selectedProperty)));\n    percent = Math.floor(((i + 1) / batches.length) * 100);\n    const now = Date.now();\n    elapsedSeconds = (now - startTime) / 1000;\n    perSecond = percent / elapsedSeconds;\n    mutable progress = { percent, elapsedSeconds, perSecond };\n  }\n  mutable progress = { percent: 100, elapsedSeconds, perSecond };\n  console.log(\"Done!\");\n  gxr.forceLayout();\n})","pinCode":false,"dname":"bf590a8a-3f65-49af-ba46-72dea90b197b","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"mutable progress = 0","pinCode":false,"dname":"a3536ee1-f88f-4adb-a9fa-a5a2f05267a5","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"async function ner(nodes, property) {\n  console.log(\"NER\", nodes, property);\n  const context = JSON.stringify(\n    nodes.map((n) => ({ nodeId: n.id, nodeContent: n.properties[property] }))\n  );\n  const schema = {\n    type: \"object\",\n    additionalProperties: false,\n    required: [\"entities\"],\n    properties: {\n      entities: {\n        type: \"array\",\n        items: {\n          type: \"object\",\n          additionalProperties: false,\n          required: [\"nodeId\", \"label\", \"category\"],\n          properties: {\n            nodeId: {\n              type: \"string\",\n              description: \"The node id which mentions the entity\",\n            },\n            label: {\n              type: \"string\",\n              description: \"The name or label of the entity. e.g. Alice\",\n            },\n            category: {\n              type: \"string\",\n              description: \"The type of the entity. e.g. Person\",\n            },\n          },\n        },\n      },\n    },\n  };\n  const prompt = `Do NER of \\`\\`\\`${context}\\`\\`\\`. Extra instructions: \"Find all entities, terms of art, and repeated phrases. Be extremely thorough. ${extraInstructions}\"`\n  console.log(prompt);\n  const response = await gxr.ask(\n    prompt,\n    { model, schema }\n  );\n  console.log(response);\n  const { entities } = JSON.parse(response);\n  console.log(entities);\n  const makeEntityId = ({ nodeId, label, category }) =>\n    `Entity::${nodeId}::${label}::${category}`;\n  const entityNodes = entities.map((n) => ({\n    id: makeEntityId(n),\n    category: \"Entity\",\n    properties: n,\n  }));\n  gxr.add(entityNodes);\n  const mentionEdges = entities.map((n) => ({\n    sourceId: n.nodeId,\n    targetId: makeEntityId(n),\n    relationship: \"MENTIONS\",\n    properties: {},\n  }));\n  gxr.add(mentionEdges);\n}","pinCode":false,"dname":"45e79137-ca8d-48c5-b08f-68de65c2099a","codeMode":"javascript2","hide":true}}}],"version":"2.19.1"}
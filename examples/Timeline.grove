{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"viewof currentCategory = render(({ useSetter }) => {\n  const { Input, Checkbox, Button, Select } = Antd;\n  const [currentValue, setCurrentValue] = useState(\"\");\n  const { Option } = Select;\n  const onSelect = (value) => {\n    setCurrentValue(value);\n  };\n  useSetter(currentValue);\n  return jsx`<div key=\"currentCategory\">\n <label style=${{ width: \"100px\" }}>Category</label>\n <${Select} onChange=${(value) => onSelect(value)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }}>${categories.map((c) => {\n    return jsx`<${Select.Option} value=${c}>${c}</${Select.Option}>`;\n  })}</${Select}>\n</div>`;\n})","pinCode":false,"dname":"ea185d90-4153-4a9e-bb08-88a61d9f7345","codeMode":"jsx"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof currentXProperty = render(({ useSetter }) => {\n  const { Input, Checkbox, Button, Select } = Antd;\n  const [currentValue, setCurrentValue] = useState(\"\");\n  const { Option } = Select;\n  const onSelect = (value) => {\n    setCurrentValue(value);\n  };\n  useSetter(currentValue);\n  return jsx`<div key=\"currentXProperty\">\n <label style=${{ width: \"100px\" }}>X Axis Property</label>\n <${Select} onChange=${(value) => onSelect(value)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }}>${currentCategoryProperties.map((c) => {\n    return jsx`<${Select.Option} value=${c}>${c}</${Select.Option}>`;\n  })}</${Select}>\n</div>`;\n})","pinCode":false,"dname":"bce5e010-b3a5-46c9-89c4-4d749a1b5dfd","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof currentYProperty = render(({ useSetter }) => {\n  const { Input, Checkbox, Button, Select } = Antd;\n  const [currentValue, setCurrentValue] = useState(\"\");\n  const { Option } = Select;\n  const onSelect = (value) => {\n    setCurrentValue(value);\n  };\n  useSetter(currentValue);\n  return jsx`<div key=\"currenYProperty\">\n <label style=${{ width: \"100px\" }}>Y Axis Property</label>\n <${Select} value=${currentValue} onChange=${(value) =>\n    onSelect(value)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }}>${currentCategoryProperties.map((c) => {\n    return jsx`<${Select.Option} value=${c}>${c}</${Select.Option}>`;\n  })}</${Select}>\n <${Button} onClick=${() => onSelect(\"\")} style=${{\n    marginLeft: \"20px\",\n    width: \"20%\",\n  }}>Clear Property</${Button}>\n</div>`;\n})","pinCode":false,"dname":"ebeae4e2-47f5-4b8d-bc52-3f718473b137","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof currentXScale = render(({ useSetter }) => {\n  const { Slider, Row } = Antd;\n  const [currentValue, setCurrentValue] = useState(1);\n  const onChangeValue = (value) => {\n    setCurrentValue(value);\n    //     \tdrawTextAndTicks(currentYScale)\n    //         applyNodesToPlot(value,currentYScale)\n  };\n  useSetter(currentValue);\n  return jsx`<${Row} key=\"currentXScale\">\n <label style=${{ width: \"100px\" }}>X Axis Scale</label>\n <${Slider} min=${1} max=${100} value=${currentValue} onChange=${(value) =>\n    onChangeValue(value)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }}></${Slider}>\n</${Row}>`;\n})","pinCode":false,"dname":"68c213e9-a2d2-478f-981b-1bcc9ea5bbb2","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof currentYScale = render(({ useSetter }) => {\n  const { Slider, Row } = Antd;\n  const [currentValue, setCurrentValue] = useState(1);\n  const onChangeValue = (value) => {\n    setCurrentValue(value);\n  };\n  useSetter(currentValue);\n  return jsx`<${Row} key=\"currentYScale\">\n <label style=${{ width: \"100px\" }}>Y Axis Scale</label>\n <${Slider} min=${1} max=${10} value=${currentValue} onChange=${(value) =>\n    onChangeValue(value)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }}></${Slider}>\n</${Row}>`;\n})","pinCode":false,"dname":"400cd28e-0bb2-4f84-9180-0caaaf9d62dd","codeMode":"javascript2","hide":false}}},{"type":"codeTool","data":{"codeData":{"value":"viewof filter = render(({ useSetter }) => {\n  const { Slider, Row } = Antd;\n  const range = calculateDateRange(\n    gxr.nodes().array.map((n) => n.properties[currentXProperty])\n  );\n  const minTimestamp = new Date(range.minDate).getTime();\n  const maxTimestamp = new Date(range.maxDate).getTime();\n  const safeMin = isNaN(minTimestamp)\n    ? new Date(\"2020-01-01\").getTime()\n    : minTimestamp;\n  const safeMax =\n    isNaN(maxTimestamp) || maxTimestamp <= safeMin\n      ? safeMin + 1000 * 60 * 60 * 24 * 365\n      : maxTimestamp;\n  const toMappedValue = (timestamp) => {\n    return ((timestamp - safeMin) / (safeMax - safeMin)) * 100;\n  };\n  const toTimestamp = (mappedValue) => {\n    return safeMin + (mappedValue / 100) * (safeMax - safeMin);\n  };\n  const [dateValues, setDateValues] = useState([0, 100]);\n  const onChangeValue = (values) => {\n    setDateValues(values);\n  };\n  const startTimestamp = toTimestamp(dateValues[0]);\n  const endTimestamp = toTimestamp(dateValues[1]);\n  useSetter({\n    minDate: new Date(startTimestamp),\n    maxDate: new Date(endTimestamp),\n  });\n  const formatter = (value) => {\n    const timestamp = toTimestamp(value);\n    const date = new Date(timestamp);\n    return date.toLocaleDateString();\n  };\n  return jsx`<${Row} key=\"dateRange\">\n <label style=${{ width: \"100px\" }}>Date Range</label>\n <${Slider} range=${true} min=${0} max=${100} value=${dateValues} onChange=${(\n    values\n  ) => onChangeValue(values)} style=${{\n    marginLeft: \"20px\",\n    width: \"30%\",\n  }} tooltip=${{ formatter: formatter }}></${Slider}>\n <div style=${{ marginLeft: \"20px\" }}>\n Start: \n ${formatter(dateValues[0])}\n  - End: \n ${formatter(dateValues[1])}\n </div>\n</${Row}>`;\n})","pinCode":false,"dname":"d6cee35f-f92b-4f53-9f01-8db85f34ff4f","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof run = render(({ useSetter }) => {\n  const { Input, Checkbox, Button, message, Space } = Antd;\n  const [messageApi, contextHolder] = message.useMessage();\n  const onRun = () => {\n    const filterNodes = gxr.nodes().array.filter((n) => {\n      let date = new Date(n.properties[currentXProperty]);\n      return (\n        date.getTime() >= filter.minDate.getTime() &&\n        date.getTime() <= filter.maxDate.getTime()\n      );\n    });\n    const updated = updateNodes(filterNodes);\n    drawTextAndTicks(updated);\n    applyNodesToPlot(updated);\n    const theme = _app.controller.API.settings.getTheme();\n    const textColor = theme == \"dark\" ? 16777215 : 0;\n    mathbox.select(\"label\").set(\"color\", textColor);\n    mathbox.select(\"label\").set(\"visible\", true);\n    mathbox.select(\"axis\").set(\"color\", textColor);\n    mathbox.select(\"axis\").set(\"visible\", true);\n  };\n  const onHidePlot = () => {\n    view.select(\"#coordinateSystem\").set(\"visible\", false);\n    nodes.forEach((n) => {\n      n.pinned = false;\n    });\n    gxr.forceLayout();\n  };\n  const onReload = () => {\n    const gxrNodes = gxr.nodes().array;\n    updateNodes(gxrNodes);\n  };\n  return jsx`<div style=${{\n    maxWidth: \"100%\",\n    margin: \"0 auto\",\n  }}> <${Space} style=${{ marginBottom: \"10px\" }}>\n   <${Button} onClick=${() => onRun()}>Apply</${Button}>\n   <${Button} onClick=${() => onHidePlot()}>Hide Plot</${Button}>\n   <${Button} onClick=${() => onReload()}>Refresh Data</${Button}>\n </${Space}></div>`;\n})","pinCode":false,"dname":"43eb7306-9f52-4748-a664-6c9258dd263d","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"function applyNodesToPlot(data){\n  \tconst positionsY = mapDataToRange(yValues)\n    const positionsX = mapDataToRange(data.xValues)\n    const filteredNodesMap = {}\n\tdata.nodes.forEach((n,idx)=>{\n      \tfilteredNodesMap[n.id] = true\n        n.position.x = (positionsX[idx]*2 - 1)*currentXScale\n      \tif(currentYProperty){\n            \tn.position.y = (positionsY[idx]*2  - 1)*currentYScale\n        }\n        n.position.z = 0\n      \tn.pinned =true\n    \n    })\n  \tconst outofRangeNodes = gxr.nodes().array.filter(n=>filteredNodesMap[n.id] ==undefined)\n    const outofRangePositionsX = mapDataToRange(outofRangeNodes.map(n=>n.properties[currentXProperty]))\n        const outofRangePositionsY = mapDataToRange(outofRangeNodes.map(n=>n.properties[currentYProperty]))\n    outofRangeNodes.forEach((n,idx)=>{\n    \tn.position.x = 2 * (outofRangePositionsX[idx]*2 - 1)*currentXScale\n//         if(currentYProperty){\n//              n.position.y = (outofRangePositionsY[idx]*2  - 1)*currentYScale\n//         }\n        n.position.z = 0\n    })\n}","pinCode":false,"dname":"d58336fe-432f-401e-827a-4547eef25b04","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function drawTextAndTicks(data) {\n  view.select(\"#coordinateSystem\").set(\"visible\", true);\n  view.select(\"#x_title\").set(\"data\", [currentXProperty]);\n  view.select(\"#y_title\").set(\"data\", [currentYProperty]);\n  updateCustomGrid(\"xy\", [1, 2], {\n    positions1: data.dateLabels.dates,\n    divideY: yLabels.labels.length,\n  });\n  const position = data.dateLabels.dates.map((day) => [day, -0.01, 0]);\n  const yPosition = yLabels.positions.map((p) => [\n    -0.005 / currentYScale,\n    p,\n    0,\n  ]);\n  const xAxisLabelPositon = mathbox.select(\"#x-label-position\");\n  const xAxisLabelText = mathbox.select(\"#x-label-text\");\n  const xAxisTicksPositon = mathbox.select(\"#x-ticks-position\");\n  xAxisLabelPositon.set(\"data\", position);\n  xAxisLabelPositon.set(\"width\", position.length);\n  xAxisLabelText.set(\"width\", data.dateLabels.labels.length);\n  xAxisLabelText.set(\"data\", data.dateLabels.labels);\n  xAxisTicksPositon.set(\"width\", position.length);\n  xAxisTicksPositon.set(\"data\", position);\n  const yAxisLabelPosition = mathbox.select(\"#y-label-position\");\n  const yAxisLabelText = mathbox.select(\"#y-label-text\");\n  yAxisLabelPosition.set(\"data\", yPosition);\n  yAxisLabelPosition.set(\"width\", yPosition.length);\n  yAxisLabelText.set(\"width\", yLabels.labels.length);\n  yAxisLabelText.set(\"data\", yLabels.labels);\n}","pinCode":false,"dname":"88a4777a-e341-4526-be0b-78456008ddd6","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function createAxis(propertyName,axis){\n  const theme = _app.controller.API.settings.getTheme()\n  const textColor = theme == \"dark\"?0xffffff:0x000000\n  let position = [0,0,0]\n  let axisValue = 1\n  switch(axis){\n    case \"x\":\n      position = [1.1, 0, 0]\n      axisValue = 1\n      break\n    case \"y\":\n      position = [0, 1.1, 0]\n      axisValue = 2\n      break\n    case \"z\":\n      position = [0, 0, 1.1]\n      axisValue = 3\n      break\n  }\n   view\n     .axis({\n        id: axis,\n        axis:axisValue,\n     \tdetail:5,\n        range: [0, 1],\n        end: true,\n        width: 10,\n        visible:false,\n        color: textColor\n      })\n     .array({\n        data: [position],\n        channels: 3,\n        live: false\n      })\n      .text({\n        id:axis+\"_title\",\n        data: [propertyName]\n      })\n      .label({\n        color: textColor,\n     \tvisible:false,\n        outline: 0,\n        size: 15\n      });\n  \n}","pinCode":false,"dname":"8a57ef4f-f36a-4284-b689-d9f6bec2f3ac","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"/**\n * Create a custom grid using vectors for better performance\n * @param {string} id - Unique ID for the grid\n * @param {Array} axes - Axis indices, e.g., [1, 2] for x-y plane\n * @param {Object} options - Configuration options\n * @param {number} options.divideX - Number of divisions on x-axis, default 30\n * @param {number} options.divideY - Number of divisions on y-axis, default 30\n * @param {Array} options.positions1 - Custom grid line positions along axis1 (normalized)\n * @param {Array} options.positions2 - Custom grid line positions along axis2 (normalized)\n * @param {number} options.color - Grid line color, default 0x888888\n * @param {number} options.width - Grid line width, default 2\n * @param {number} options.opacity - Grid line opacity, default 1\n * @param {Array} options.range - Custom range, defaults to view range\n */\nfunction createCustomGrid(id, axes, options = {}) {\n    // Default options\n    const defaults = {\n        divideX: 30,\n        divideY: 30,\n        positions1: null,\n        positions2: null,\n        color: 0x888888,\n        width: 2,\n        opacity: 1,\n        range: null\n    };\n    \n    // Merge user options with defaults\n    const opts = { ...defaults, ...options };\n    \n    // Calculate axis indices (convert to 0-based)\n    const axis1 = axes[0] - 1; \n    const axis2 = axes[1] - 1;\n    \n    // Define axis ranges (normalized coordinates from 0 to 1)\n    const min1 = 0;\n    const max1 = 1;\n    const min2 = 0;\n    const max2 = 1;\n    \n    // Determine positions for the first set of lines (along axis1)\n    let positions1 = opts.positions1 || linspace(min1, max1, opts.divideX + 1);\n    // Ensure the endpoint is included\n    if (positions1[positions1.length - 1] !== max1) {\n        positions1 = [...positions1, max1];\n    }\n    \n    // Determine positions for the second set of lines (along axis2)\n    let positions2 = opts.positions2 || linspace(min2, max2, opts.divideY + 1);\n    // Ensure the endpoint is included\n    if (positions2[positions2.length - 1] !== max2) {\n        positions2 = [...positions2, max2];\n    }\n    \n    // Create grid group if it doesn't exist\n    if (!view.select(`#${id}`).length) {\n        view.group({\n            id: id\n        });\n    } else {\n        // If it exists, clear all child elements\n        view.select(`#${id} > *`).remove();\n    }\n    \n    // Prepare data for vertical lines (along axis2 direction)\n    const verticalLinesData = [];\n    positions1.forEach(pos => {\n        // Start point\n        verticalLinesData.push([pos, min2, 0]);\n        // End point\n        verticalLinesData.push([pos, max2, 0]);\n    });\n    \n    // Create vertical lines using a single vector\n    view.select(`#${id}`).array({\n        id: `${id}-vertical-lines`,\n        data: verticalLinesData,\n        channels: 3, // x, y, z\n        items: 2,    // Each line has 2 points\n        width: positions1.length, // Number of lines\n        live: false,\n    }).vector({\n        color: opts.color,\n        width: opts.width,\n        opacity: opts.opacity,\n        end: true,\n    });\n    \n    // Prepare data for horizontal lines (along axis1 direction)\n    const horizontalLinesData = [];\n    positions2.forEach(pos => {\n        // Start point\n        horizontalLinesData.push([min1, pos, 0]);\n        // End point\n        horizontalLinesData.push([max1, pos, 0]);\n    });\n    \n    // Create horizontal lines using a single vector\n    view.select(`#${id}`).array({\n        id: `${id}-horizontal-lines`,\n        data: horizontalLinesData,\n        channels: 3, // x, y, z\n        items: 2,    // Each line has 2 points\n        width: positions2.length, // Number of lines\n        live: false,\n    }).vector({\n        color: opts.color,\n        width: opts.width,\n        opacity: opts.opacity,\n        end: true,\n    });\n}","pinCode":false,"dname":"78989a1f-661f-4158-92a0-07cfe4083d2f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"// Initialize a custom grid structure\n// @param {string} id - Unique identifier for the grid\n// @param {Array} axes - Axis indices, e.g., [1, 2] represents the x-y plane\n// @param {Object} options - Configuration options\n// @param {number} options.color - Grid line color, defaults to 0x888888\n// @param {number} options.width - Grid line width, defaults to 2\n// @param {number} options.opacity - Grid line opacity, defaults to 1\nfunction initializeCustomGrid(id, axes, options = {}) {\n    // Default style options\n    const defaults = {\n        color: 0x888888,\n        width: 2,\n        opacity: 1\n    };\n    const opts = { ...defaults, ...options };\n\n    // Create grid group if it doesn't exist, otherwise clear its children\n    if (!view.select(`#${id}`).length) {\n        view.group({ id: id });\n    } else {\n        view.select(`#${id} > *`).remove();\n    }\n\n    // Create array object for vertical lines\n    view.select(`#${id}`)\n        .array({\n            id: `${id}-vertical-lines`,\n            data: [],         // Initially empty data\n            channels: 3,      // x, y, z coordinates\n            items: 2,         // Each line segment has 2 points\n            live: false       // Static data, no continuous updates needed\n        })\n        .vector({\n            color: opts.color,\n            width: opts.width,\n            opacity: opts.opacity,\n            end: false\n        });\n\n    // Create array object for horizontal lines\n    view.select(`#${id}`)\n        .array({\n            id: `${id}-horizontal-lines`,\n            data: [],         // Initially empty data\n            channels: 3,\n            items: 2,\n            live: false\n        })\n        .vector({\n            color: opts.color,\n            width: opts.width,\n            opacity: opts.opacity,\n            end: false\n        });\n}","pinCode":false,"dname":"f679bbf8-ed26-4c49-88e4-56d56a312957","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"// Update the data of a custom grid\n// @param {string} id - Unique identifier for the grid\n// @param {Array} axes - Axis indices, e.g., [1, 2] represents the x-y plane\n// @param {Object} options - Configuration options\n// @param {number} options.divideX - Number of divisions along the x-axis, defaults to 30\n// @param {number} options.divideY - Number of divisions along the y-axis, defaults to 30\n// @param {Array} options.positions1 - Custom grid line positions along axis1 (normalized)\n// @param {Array} options.positions2 - Custom grid line positions along axis2 (normalized)\n// @param {Array} options.range - Custom range, defaults to null (uses 0 to 1)\nfunction updateCustomGrid(id, axes, options = {}) {\n    // Default options\n    const defaults = {\n        divideX: 30,\n        divideY: 30,\n        positions1: null,\n        positions2: null,\n        range: null\n    };\n    const opts = { ...defaults, ...options };\n\n    // Convert axis indices to 0-based\n    const axis1 = axes[0] - 1; // e.g., x-axis\n    const axis2 = axes[1] - 1; // e.g., y-axis\n\n    // Normalized range (0 to 1)\n    const min1 = 0;\n    const max1 = 1;\n    const min2 = 0;\n    const max2 = 1;\n\n    // Calculate positions for vertical lines (along axis1)\n    let positions1 = opts.positions1 || linspace(min1, max1, opts.divideX + 1);\n    if (positions1[positions1.length - 1] !== max1) {\n        positions1 = [...positions1, max1];\n    }\n\n    // Calculate positions for horizontal lines (along axis2)\n    let positions2 = opts.positions2 || linspace(min2, max2, opts.divideY + 1);\n    if (positions2[positions2.length - 1] !== max2) {\n        positions2 = [...positions2, max2];\n    }\n\n    // Prepare data for vertical lines\n    const verticalLinesData = [];\n    positions1.forEach(pos => {\n        verticalLinesData.push([pos, min2, 0]); // Start point\n        verticalLinesData.push([pos, max2, 0]); // End point\n    });\n\n    // Prepare data for horizontal lines\n    const horizontalLinesData = [];\n    positions2.forEach(pos => {\n        horizontalLinesData.push([min1, pos, 0]); // Start point\n        horizontalLinesData.push([max1, pos, 0]); // End point\n    });\n\n    // Update the data of array objects\n    view.select(`#${id}-vertical-lines`).set(\"data\", verticalLinesData);\n    view.select(`#${id}-horizontal-lines`).set(\"data\", horizontalLinesData);\n}","pinCode":false,"dname":"6da26248-87c7-45ed-9954-f1117b2e392f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"init()","pinCode":false,"dname":"c595652a-c84d-4719-a480-c0ddd532ea08","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function init(){\n   \tif(window.inited){\n    \treturn\n    }\n\tcreateAxis(\"x\",\"x\")\n    createAxis(\"y\",\"y\")\n  \n  \tbuildAxisLabelAndTicks(\"x\",true)\n    buildAxisLabelAndTicks(\"y\",false)\n  \tinitializeCustomGrid(\"xy\",[1, 2])\n    \n  \n       _app.controller.API.useRender(() => {\n    let cloud = _app.controller.drawing.cloudScene;\n    let cloudScenePosition = cloud.position;\n    let cloudSceneRotation = cloud.rotation;\n    view.set(\"position\", [cloudScenePosition.x, cloudScenePosition.y, cloudScenePosition.z]);\n    view.set(\"rotation\", [cloudSceneRotation.x, cloudSceneRotation.y, cloudSceneRotation.z]);\n  });\n  \n  \n    window.inited = true\n}","pinCode":false,"dname":"dbe9a452-66e3-4970-ae14-e7068dc22dc2","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function buildAxisLabelAndTicks(id,showTicks = true){\n    const theme = _app.controller.API.settings.getTheme()\n    const textColor = theme == \"dark\"?0xffffff:0x000000\n\t    view\n        .array({\n   \t\tid:`${id}-label-position`,\n  \t\tdata:[],\n \t\tchannels: 3\n        })\n        .text({\n          id:`${id}-label-text`,\n          data:[],\n          live: false\n        })\n        .label({\n          id:`${id}-label`,\n          color: textColor,\n          size: 12,\n          outline:0,\n          offset:showTicks?[0,-20]:[0,10]\n        });\n  \n  \tif(showTicks){\n    \t    view\n       .array({\n        id:`${id}-ticks-position`,\n        data: [],\n        channels: 3\n      })\n      .ticks({\n              id:`${id}-ticks`,\n              width: 8,\n              size: 20,\n              color: textColor\n            })\n    }\n}","pinCode":false,"dname":"d1aa58ce-6e71-431b-b8b0-779ad2545816","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"view = {\n  try {\n    // Check if mathbox is defined and has the select method\n    if (typeof mathbox !== 'undefined' && mathbox.select) {\n      let v = mathbox.select(\"#coordinateSystem\");\n      // Verify the view exists before setting properties\n      if (v && v.length > 0) {\n        v.set(\"scale\", [currentXScale, currentYScale]);\n        return v;\n      }\n    }\n    // Create a new cartesian view if it doesn't exist\n    return mathbox.cartesian({\n      id: \"coordinateSystem\",\n      range: [[0, 1], [0, 1]],\n      scale: [currentXScale, currentYScale],\n    });\n  } catch (e) {\n    return e;\n  }\n}","pinCode":true,"dname":"a820e1e0-b817-473b-a5c4-739f69e40f06","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable nodes = graph.nodes().values()","pinCode":false,"dname":"0569bdc0-284b-471e-985c-89286769088f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function updateNodes(newNodes){\n  mutable nodes = newNodes\n  const newXValue  = newNodes.map(n=>n.properties[currentXProperty])\n  mutable xValues = newXValue\n  const newDateRange = calculateDateRange(newXValue)\n  mutable dateRange = newDateRange\n  const newDateLabels = generateDateLabels(newDateRange.minDate,newDateRange.days)\n  debugger\n  mutable dateLabels =  newDateLabels\n  \n  return {nodes:newNodes,xValues:newXValue,dateRange:newXValue,dateLabels:newDateLabels}\n}","pinCode":false,"dname":"322a7213-bcbc-4bd3-bb74-2f82094dd478","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"currentCategoryProperties = _.uniq(_.flatMap(nodes.filter(x=>x.category == currentCategory).map(n=>Object.keys(n.properties))))","pinCode":false,"dname":"85103510-3a31-4696-a66a-28c5908961c6","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable xValues = nodes.map(n=>n.properties[currentXProperty])","pinCode":false,"dname":"22ae26c0-41d2-472c-8e08-38e37b266a52","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable dateRange = calculateDateRange(xValues)","pinCode":false,"dname":"da186018-292a-4783-bc3c-50ee0bba74d0","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable globalDateRange = calculateDateRange(\n  gxr.nodes().array.map((n) => n.properties[currentXProperty])\n)","pinCode":true,"dname":"acb500e1-082a-4242-a365-e8d7be9ff00a","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable dateLabels =  generateDateLabels(dateRange.minDate,dateRange.days)","pinCode":false,"dname":"aba3bfac-1555-409e-a9ba-24066755b94b","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable yLabels = generateYLabels(yValues)","pinCode":false,"dname":"1f8b7887-73ee-46df-984e-4cdc4d807611","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"yValues = nodes.map((n) => n.properties[currentYProperty])","pinCode":false,"dname":"13c7ca02-39c6-4f9f-97cf-f062ef6b368f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"categories = _.uniq(nodes.map(n=>n.category))","pinCode":false,"dname":"11be99ee-e25b-4b69-9d0e-c04091c8575f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function isValidDate(dateString) {\n    const date = new Date(dateString);\n    return !isNaN(date.getTime());\n}","pinCode":false,"dname":"ea3746ea-b6d5-43cd-a100-54589ae48d33","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function generateDateLabels(startDate, totalDays) {\n   if (!startDate) {\n       return { dates: [], labels: [] };\n   }\n\n   const dates = [];  // Stores normalized date positions (from 0 to 1)\n   const labels = []; // Stores display labels\n\n   // Constant to control label density; adjusting this changes label count\n   const k = 2;\n   let numberOfLabels = Math.ceil(currentXScale * k);\n\n   // Ensure at least two labels (start and end)\n   numberOfLabels = Math.max(numberOfLabels, 2);\n\n   // Calculate interval between labels\n   const interval = Math.ceil(totalDays / (numberOfLabels - 1));\n\n   // Determine time unit based on interval\n   let unit;\n   if (interval > 365) {\n       unit = 'year';\n   } else if (interval > 30) {\n       unit = 'month';\n   } else {\n       unit = 'day';\n   }\n\n   // Calculate the end date\n   const endDate = new Date(startDate);\n   endDate.setDate(startDate.getDate() + totalDays);\n\n   // Generate dates and labels based on the unit\n   if (unit === 'year') {\n       let currentDate = new Date(startDate);\n       currentDate.setMonth(0); // Set to January\n       currentDate.setDate(1);  // Set to the first day of the month\n       if (currentDate < startDate) {\n           currentDate.setFullYear(currentDate.getFullYear() + 1);\n       }\n       while (currentDate <= endDate) {\n           const daysFromStart = (currentDate - startDate) / (1000 * 60 * 60 * 24);\n           const normalizedDay = daysFromStart / totalDays;\n           dates.push(normalizedDay);\n           const year = currentDate.getFullYear();\n           labels.push(`${year}`);\n           currentDate.setFullYear(currentDate.getFullYear() + 1);\n       }\n   } else if (unit === 'month') {\n       let currentDate = new Date(startDate);\n       currentDate.setDate(1); // Set to the first day of the month\n       if (currentDate < startDate) {\n           currentDate.setMonth(currentDate.getMonth() + 1);\n       }\n       while (currentDate <= endDate) {\n           const daysFromStart = Math.round((currentDate - startDate) / (1000 * 60 * 60 * 24));\n           const normalizedDay = daysFromStart / totalDays;\n           dates.push(normalizedDay);\n           const month = currentDate.toLocaleString('default', { month: 'short' });\n           const year = currentDate.getFullYear();\n            if(month == \"Jan\"){\n              labels.push(`${month} ${year}`);\n            }\n            else{\n               labels.push(`${month}`);\n            }\n            \n\n           currentDate.setMonth(currentDate.getMonth() + 1);\n       }\n   } else if (unit === 'day') {\n       for (let i = 0; i <= totalDays; i += interval) {\n           const currentDate = new Date(startDate);\n           currentDate.setDate(startDate.getDate() + i);\n           if (currentDate > endDate) break;\n           const normalizedDay = i / totalDays;\n           dates.push(normalizedDay);\n           const month = currentDate.getMonth() + 1;\n           const day = currentDate.getDate();\n           const year = currentDate.getFullYear();\n           labels.push(`${year}/${month}/${day}`);\n       }\n   }\n\n   // Ensure at least two labels (start and end)\n   if (dates.length < 2) {\n       dates.length = 0;\n       labels.length = 0;\n\n       // Add start date\n       dates.push(0);\n       const startYear = startDate.getFullYear();\n       labels.push(`${startYear}`);\n\n       // Add end date\n       dates.push(1);\n       const endYear = endDate.getFullYear();\n       labels.push(`${endYear}`);\n   }\n\n   return { dates, labels };\n}\n","pinCode":false,"dname":"d1b1685b-371d-48cc-8868-0fce993b41d7","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function generateYLabels(data) {\n  const positions = [];\n  const labels = [];\n  if (data.length === 0) return { positions, labels };\n  \n  const isStringData = typeof data[0] === 'string';\n  \n  if (isStringData) {\n    const uniqueCategories = [...new Set(data)]; \n    const categoryCount = uniqueCategories.length;\n    \n    uniqueCategories.forEach((category, index) => {\n      positions.push((index+1)/categoryCount);\n      labels.push(category);\n    });\n  } else {\n    data  = data.filter(d=>d!=undefined)\n    const minValue = Math.min(...data);\n    const maxValue = Math.max(...data);\n    \n    const range = maxValue - minValue;\n    const maxTicks = 10; \n    const roughStep = range / (maxTicks - 1);\n    \n    const magnitude = Math.pow(10, Math.floor(Math.log10(roughStep)));\n    let step;\n    if (roughStep / magnitude < 1.5) step = magnitude;\n    else if (roughStep / magnitude < 3) step = 2 * magnitude;\n    else if (roughStep / magnitude < 7.5) step = 5 * magnitude;\n    else step = 10 * magnitude;\n    \n    const firstTick = Math.ceil(minValue / step) * step;\n    for (let tick = firstTick; tick <= maxValue + step/2; tick += step) {\n      positions.push((tick - minValue)/range);\n      \n      const label = tick.toFixed(2).replace(/\\.?0+$/, '');\n      labels.push(label);\n    }\n  }\n  \n  return { positions, labels };\n}","pinCode":false,"dname":"ea601e53-9bec-4730-a7bd-9fa35bff68a1","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mapDataToRange(yValues)","pinCode":false,"dname":"b9537d58-2a2a-43e2-8d39-4593ce572198","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function mapDataToRange(data) {\n  if (!data || data.length === 0) return [];\n  \n  // Check data type\n  let dataType = \"\"\n  const firstItem = data.filter(d=>d!==undefined)[0];\n  if (firstItem instanceof Date) {\n    dataType = 'date';\n  } else if (typeof firstItem === 'string' && !isNaN(Date.parse(firstItem))) {\n    dataType = 'date';\n  } else {\n    dataType = typeof firstItem;\n  }\n  \n  switch (dataType) {\n    case 'date':\n      return mapDatesToRange(data);\n    case 'string':\n      return mapStringsToRange(data);\n    case 'number':\n      return mapNumbersToRange(data);\n    default:\n      console.warn('Unsupported data type:', dataType);\n      return data.map(() => 0.5); // Default to middle value\n  }\n}","pinCode":false,"dname":"0d347b4f-de66-43c7-b12e-7fd5d7da5c00","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function mapDatesToRange(dates) {\n  if (dates.length === 0) return [];\n  if (dates.length === 1) return [0.5]; // Single date returns middle value\n\n  // Convert string dates to Date objects and filter out invalid dates\n  const dateObjects = dates.map(dateStr => new Date(dateStr)).filter(date => !isNaN(date.getTime()));\n\n  if (dateObjects.length === 0) return []; // Return an empty array if all dates are invalid\n\n  // Find the earliest and latest dates\n  const minDate = new Date(Math.min(...dateObjects.map(d => d.getTime())));\n  const maxDate = new Date(Math.max(...dateObjects.map(d => d.getTime())));\n\n  // Calculate the time range in milliseconds\n  const timeRange = maxDate.getTime() - minDate.getTime();\n\n  // If all dates are the same, return an array of middle values\n  if (timeRange === 0) return dates.map(() => 0.5);\n\n  // Map each date to a range between 0 and 1\n  return dateObjects.map(date => (date.getTime() - minDate.getTime()) / timeRange);\n}","pinCode":false,"dname":"882907ea-3ca7-45f8-af18-15727321272e","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function mapStringsToRange(strings) {\n  if (strings.length === 0) return [];\n  if (strings.length === 1) return [0.5]; // Single string returns middle value\n  \n  // Remove duplicates\n  const uniqueStrings = [...new Set(strings)];\n  \n  // Create mapping from string to index\n  const stringMap = {};\n  uniqueStrings.forEach((str, index) => {\n    stringMap[str] = index + 1\n  });\n  \n  // Calculate category count\n  const categoryCount = uniqueStrings.length;\n  \n  // Map each string to 0-1 range\n  return strings.map(str => {\n    return categoryCount > 1 ? stringMap[str] / (categoryCount) : 0.5;\n  });\n}","pinCode":false,"dname":"5eb5956c-dfcc-409b-a1f7-1d18ed887aca","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function mapNumbersToRange(numbers) {\n  if (numbers.length === 0) return [];\n  if (numbers.length === 1) return [0.5]; // Single number returns middle value\n  \n  // Find min and max values\n  const minValue = Math.min(...numbers.filter(n=>n!==undefined));\n  const maxValue = Math.max(...numbers.filter(n=>n!==undefined));\n  \n  // Calculate value range\n  const valueRange = maxValue - minValue;\n  \n  // If range is 0 (all numbers are the same), return middle value\n  if (valueRange === 0) return numbers.map(() => 0.5);\n  \n  // Map each number to 0-1 range\n  return numbers.map(num => {\n    if(num == undefined)\n      return 0\n    return (num - minValue) / valueRange;\n  });\n}\n","pinCode":false,"dname":"c81e6058-68f6-48d1-8341-36d2cc90453d","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function calculateDateRange(dateList) {\n  \t\n    const dates = dateList.filter(d=>d).map(dateStr => new Date(dateStr));\n    dates.sort((a, b) => a - b);\n    const minDate = dates[0];\n    const maxDate = dates[dates.length - 1];\n\n    const timeDifference = maxDate - minDate;\n    const daysDifference = timeDifference / (1000 * 60 * 60 * 24);\n\n    return {\n        minDate: minDate,\n        maxDate: maxDate,\n        days: daysDifference\n    };\n}","pinCode":false,"dname":"0d978e3d-40d0-47bb-b2be-3ee6a1ccfe7f","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"function linspace(start, end, n) {\n    const step = (end - start) / (n - 1);\n    return Array.from({ length: n }, (_, i) => start + i * step);\n}","pinCode":false,"dname":"02dc814c-1d09-415e-bfce-e649c4a290fc","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mathbox = _app.controller.API.mathbox;","pinCode":false,"dname":"add5f6b6-d174-4532-9aa4-1f0b5b43fbb9","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"import {jsx, render, useState, component, useEffect, Fragment } from \"https://grove-help.graphxr.com/react/react\"","pinCode":false,"dname":"adcae353-ccc8-48e8-8cbc-63ed28da6de9","codeMode":"javascript2","hide":true}}}],"version":"2.19.1"}
{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"viewof instructions = Inputs.textarea({\n  label: \"Instructions\",\n  value:\n    \"Summarize the nodes with references to the node ids. write the full node id as a special markdown link like [<index>](nodeId=<node id>). If there is a common prefix amongst multiple node ids, prefer to write the full reference. <index> ranges from 1 to n, where n is the number of references.\",\n})","pinCode":false,"dname":"f6a1bf1f-ace9-4893-bbcb-ca1e3ad5c9e7","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"html`${await Button(\"Run on selected nodes\", async () => {\n  const nodes = gxr.nodes(\"[[selected]]\").values();\n  const contents = nodes;\n  const context = JSON.stringify(contents);\n  console.log(context);\n  const query = `Instructions: ${instructions}. Apply instructions to the context. Context: \\`\\`\\`${context}\\`\\`\\``;\n  const response = await gxr.ask(query, { model: \"gpt-4.1-mini\" });\n  console.log(response);\n  mutable summary = response;\n  await gxr.sleep(1000);\n  await renderSummary(response);\n})}${await Button(\"Clear Summary\", async () => {\n  mutable summary = \"\";\n})}${await Button(\"Clear Citation Focus\", async () => {\n  if (gxr.nodes(\"[[selected]]\").values().length > 0) {\n    gxr.nodes().alpha(0.4);\n    gxr.nodes(\"[[selected]]\").alpha(1);\n  } else {\n    gxr.nodes().alpha(1);\n  }\n})}`","pinCode":false,"dname":"a801e75d-5ad5-43e3-977c-2e73894bf587","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"${summary}","pinCode":false,"dname":"10c40a75-a960-4ec8-bbe1-9a60080dbd57","codeMode":"markdown"}}},{"type":"codeTool","data":{"codeData":{"value":"async function renderSummary() {\n  // Select all <a> elements with href containing 'nodeId='\n  const links = document.querySelectorAll('a[href*=\"nodeId=\"]');\n  console.log(links);\n  links.forEach((link) => {\n    const href = link.getAttribute(\"href\");\n    // Extract the nodeId value using a regex\n    const match = href.match(/nodeId=([^&]+)/);\n    if (match && match[1]) {\n      const nodeId = match[1];\n      // Create a new <a> element\n      const newLink = document.createElement(\"a\");\n      newLink.textContent = link.textContent;\n      newLink.href = \"#\";\n      // Prevent default navigation\n      // Copy other attributes except href\n      for (const attr of link.attributes) {\n        if (attr.name !== \"href\") {\n          newLink.setAttribute(attr.name, attr.value);\n        }\n      }\n      // Add onClick handler to log the nodeId\n      newLink.addEventListener(\"click\", (event) => {\n        event.preventDefault();\n        // Prevent default link behavior\n        console.log(`Inspecting node ${nodeId}`);\n        const nodes = gxr.nodes(nodeId);\n        gxr.nodes().alpha(0.4);\n        nodes.alpha(1);\n        gxr.centerTo(nodes);\n        gxr.showNodeInfoPanel(nodeId);\n      });\n      // Replace the old link with the new one\n      link.parentNode.replaceChild(newLink, link);\n    }\n  });\n}","pinCode":false,"dname":"ca60eb37-bdc6-4e10-b20e-115ea2a7ee40","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"mutable summary = \"\"","pinCode":false,"dname":"3a456f2b-f915-44b0-817c-9f1e49797dbe","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"api = {\n  /**\n * Extracts JSON from a text string that contains markdown-formatted JSON\n * @param {string} text - The input text containing JSON within markdown code blocks\n * @returns {object|null} - The parsed JSON object or null if no valid JSON found\n */  function extractJsonFromText(text) {\n    // Regular expression to match content between ```json and ``` markers\n    const jsonRegex = /```json\\s*([\\s\\S]*?)\\s*```/;\n    // Try to find a match\n    const match = text.match(jsonRegex);\n    if (match && match[1]) {\n      try {\n        // Parse the extracted JSON string\n        return JSON.parse(match[1]);\n      } catch (error) {\n        console.error(\"Failed to parse JSON:\", error);\n        return null;\n      }\n    }\n    return null;\n  }\n  return { extractJsonFromText };\n}","pinCode":false,"dname":"3fe0b312-2350-46ab-8abb-603b14588f39","codeMode":"javascript2","hide":true}}}],"version":"2.19.1"}
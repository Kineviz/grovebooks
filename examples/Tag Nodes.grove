{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"md`# Tag nodes in the canvas`","pinCode":false,"dname":"e2f2bc7e-3826-469d-a17d-2c522d2c467e","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof taggingPrompt = Inputs.select([...Object.keys(taggingPrompts), \"Custom\"])","pinCode":false,"dname":"35c24f17-1a9c-4552-a610-b528e6906c18","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof taggingInstructions = Inputs.textarea({\n  disabled: taggingPrompt != \"Custom\",\n  label: \"Instructions\",\n  value: taggingPrompt != \"Custom\" ? \"<redacted>\" : \"Describe your tags here\",\n})","pinCode":false,"dname":"558be0c2-cb68-48b0-9361-cd38746ed75e","codeMode":"javascript2","hide":false}}},{"type":"codeTool","data":{"codeData":{"value":"viewof tagsList = Inputs.textarea({\n  disabled: taggingPrompt != \"Custom\",\n  label: \"Tags (comma separated)\",\n  value:\n    taggingPrompt != \"Custom\"\n      ? \"<redacted>\"\n      : \"Write your tags in a comma separated list. e.g. Fruit,Vegetable,Legume\",\n})","pinCode":false,"dname":"244a316a-5237-463d-b1aa-2efe4b87ed90","codeMode":"javascript2","hide":false}}},{"type":"codeTool","data":{"codeData":{"value":"html`${await Button(\"Run on selected Messages\", async () => {\n  const nodes = gxr\n    .nodes(\"[[selected]]\")\n    .filter((n) => n.category == \"Message\")\n    .values();\n  for (const node of nodes) {\n    const content = node.properties[\"content\"];\n    const tags = await getTags(content);\n    console.log(tags);\n    node.tags = tags;\n  }\n  gxr.dispatchGraphDataUpdate();\n})}${await Button(\"Clear Tags\", async () => {\n  gxr.nodes().forEach((node) => {\n    node.tags = [];\n  });\n  gxr.dispatchGraphDataUpdate();\n})}`","pinCode":false,"dname":"76afdfcb-b7a9-4fd6-b563-260fa49ab415","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"async function getTags(content) {\n  const system = `Extract a list of tags in JSON format from the user's input. Tags do not start with hash tags. The tags should fit the theme: \\`\\`\\`${taggingPrompts[taggingPrompt].prompt}\\`\\`\\`.`;\n  const tags =\n    taggingPrompt == \"Custom\"\n      ? tagsList.split(\",\")\n      : taggingPrompts[taggingPrompt].tags;\n  const schema = {\n    type: \"object\",\n    properties: {\n      tags: {\n        type: \"array\",\n        items: {\n          type: \"string\",\n          description: \"The tags of the content\",\n          enum: tags,\n        },\n      },\n    },\n    required: [\"tags\"],\n    additionalProperties: false,\n  };\n  const result = await gxr.ask(content, { model: \"gpt-4.1-mini\", schema });\n//   const result = await ask(content, {\n//     system,\n//     model: \"gpt-4.1-nano\",\n//     schema,\n//   });\n  console.log(content, result);\n  const json = JSON.parse(result);\n  if (json && json.tags) {\n    return json.tags;\n  }\n  return [];\n}","pinCode":false,"dname":"cd57f5e6-423b-4346-9a88-33fd3557aa1e","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"taggingPrompts = ({\n  \"Sensitive Topics in Corporate Emails\": {\n    prompt: `# Sensitive Topics in Corporate Emails\n\nHere is a list of topics that are generally considered sensitive and should be avoided or handled with extreme caution in corporate emails, along with explanations:\n\nRegarding Employees & Personnel:\n\n- Personal Health Information (PHI): Any details about an employee's medical conditions, diagnoses, treatments, or disabilities. HIPAA.\n- Compensation and Benefits: Specific salary figures, bonus amounts, stock options, or details about individual benefits packages.\n- Performance Evaluations and Feedback (Negative): Sharing negative performance reviews, disciplinary actions, or termination discussions.\n- Promotions, Demotions, and Transfers (Prematurely): Announcing personnel changes before they are officially communicated.\n- Layoffs or Restructuring: Discussing potential or actual layoffs or organizational restructuring outside of official announcements.\n- Personal Opinions or Gossip about Colleagues: Sharing subjective opinions, rumors, or negative comments about other employees.\n- Protected Characteristics: Any discussions that could be construed as discriminatory or biased based on race, religion, gender, sexual orientation, age, disability, or other protected characteristics.\n- Internal Investigations: Details about ongoing internal investigations, including names of individuals involved or specific allegations\n\nRegarding Company Finances & Strategy:\n\n- Financial Performance (Unreleased): Sharing unreleased financial results, forecasts, or sensitive financial data that could impact stock prices or investor confidence.\n- Mergers, Acquisitions, or Divestitures (Unannounced): Discussing potential or ongoing M&A activity, (insider trading).\n- Strategic Plans and Future Initiatives (Confidential): Details about upcoming product launches, market expansion plans, or significant strategic shifts that are not yet public.\n- Intellectual Property and Trade Secrets: confidential information about patents, formulas, algorithms, customer lists, or other proprietary information that gives the company a competitive advantage.\n- Legal Matters and Litigation: Discussions about ongoing lawsuits, legal threats, or confidential legal advice\n\nRegarding Customers & External Parties:\n\n- Confidential Customer Information: Sharing sensitive customer data (e.g., credit card details, personal addresses, specific purchase history)\n- Negative Comments about Clients or Partners: Expressing unprofessional or disparaging remarks about customers, vendors, or business partners.\n- Pricing and Contract Negotiations (Internal Discussions): internal discussions about pricing strategies or contract negotiation points.\n\nRegarding Legal & Compliance:\n\n- Passwords and Credentials\n- Social Security Numbers, Bank Account Details, highly sensitive personal identification numbers, or financial account information.\n- Violations of Company Policy or Illegal Activities: Reporting or discussing potential illegal activities or serious policy violations (e.g., HR, legal, ethics)\n\nGeneral Communication Issues:\n\n- Expletives like fuck, shit, damn, etc, and combinations / conjugations of those.\n- Highly Emotional or Angry Communication: Emails sent in anger or containing strong emotional language\n- Ambiguous or Unclear Language: Emails that are open to multiple interpretations`,\n    tags: [\n      \"Personal Health Information\",\n      \"Compensation and Benefits\",\n      \"Negative Performance Feedback\",\n      \"Premature Personnel Changes\",\n      \"Layoffs or Restructuring\",\n      \"Personal Opinions or Gossip\",\n      \"Protected Characteristics\",\n      \"Internal Investigations\",\n      \"Unreleased Financial Performance\",\n      \"Unannounced Mergers or Acquisitions\",\n      \"Confidential Strategic Plans\",\n      \"Intellectual Property and Trade Secrets\",\n      \"Legal Matters and Litigation\",\n      \"Confidential Customer Information\",\n      \"Negative Comments about Clients or Partners\",\n      \"Internal Pricing and Contract Negotiations\",\n      \"Passwords and Credentials\",\n      \"Sensitive Personal Identification Numbers\",\n      \"Violations of Company Policy or Illegal Activities\",\n      \"Expletives\",\n      \"Highly Emotional or Angry Communication\",\n      \"Ambiguous or Unclear Language\",\n    ],\n  },\n  \"Sensitive Topics in Family Law\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Employment Law\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Intellectual Property\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Estate Planning\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Bankruptcy\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Immigration\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Environmental\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Health\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in International\": { prompt: \"\", tags: [] },\n  \"Sensitive Topics in Personal Injury\": { prompt: \"\", tags: [] },\n})","pinCode":false,"dname":"094ae781-e119-42cf-859a-090d5b155d38","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"/**\n * Sends a chat completion request to OpenAI with simplified parameters\n * @param {string} userMessage - The content of the first user message\n * @param {Object} options - Configuration options\n * @param {string} [options.system] - Optional system prompt\n * @param {string} [options.model=\"gpt-4o-mini\"] - Model to use\n * @param {number} [options.temperature=0.7] - Temperature setting\n * @returns {Promise} - Promise resolving to the API response\n */\nasync function ask(userMessage, options = {}) {\n  // Set default values\n  const model = options.model || \"gpt-4o-mini\";\n  const temperature = options.temperature ?? 0.7;\n  \n  // Build messages array\n  const messages = [];\n  \n  // Add system message if provided\n  if (options.system) {\n    messages.push({\n      role: \"system\",\n      content: options.system\n    });\n  }\n  \n  // Add user message\n  messages.push({\n    role: \"user\",\n    content: userMessage\n  });\n  \n  // Prepare request body\n  const requestBody = {\n    model: model,\n    messages: messages,\n    temperature: temperature\n  };\n  \n  if (options.schema) {\n    requestBody['response_format'] = {\n      type: \"json_schema\",\n      json_schema: {\n        name: \"response\",\n        strict: true,\n        schema: options.schema,\n      },\n    }\n  }\n  \n  try {\n    const response = await fetch(\"http://litellm-proxy.tail3cd02.ts.net:38383/chat/completions\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": \"Bearer sk-m7qGTIPyoP1LPqpj_tQC3A\"\n      },\n      body: JSON.stringify(requestBody)\n    });\n    \n    if (!response.ok) {\n      throw new Error(`API request failed with status ${response.status}`);\n    }\n    \n    const json = await response.json();\n    return json.choices[0].message.content;\n  } catch (error) {\n    console.error(\"Error sending chat completion request:\", error);\n    throw error;\n  }\n}","pinCode":false,"dname":"9f829a33-0081-4685-9db6-7395b47bb612","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"/**\n * Extracts JSON from a text string that contains markdown-formatted JSON\n * @param {string} text - The input text containing JSON within markdown code blocks\n * @returns {object|null} - The parsed JSON object or null if no valid JSON found\n */\nfunction extractJsonFromText(text) {\n  // Regular expression to match content between ```json and ``` markers\n  const jsonRegex = /```json\\s*([\\s\\S]*?)\\s*```/;\n  // Try to find a match\n  const match = text.match(jsonRegex);\n  if (match && match[1]) {\n    try {\n      // Parse the extracted JSON string\n      return JSON.parse(match[1]);\n    } catch (error) {\n      console.error(\"Failed to parse JSON:\", error);\n      return null;\n    }\n  }\n  return null;\n}","pinCode":false,"dname":"7c9f3d1c-b88f-4562-aa9b-6db36863bf28","codeMode":"javascript2","hide":true}}}],"version":"2.19.1"}
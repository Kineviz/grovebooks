{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"# README\n\nThis Grovebook implements Semantic Search over a Kuzu database output from the pdf_km_server. The embedding model used was `all-MiniLM-L6-v2`. Embeddings are computed using Ollama running on http://localhost:11434. The default embedding model used with Ollama is `all-minilm`, so the user must run `ollama pull all-minilm` before this example will work.\n\nAlso, Ollama needs to be accessible on the network. On MacOS, run these and restart Ollama.\n\n```\nlaunchctl setenv OLLAMA_ORIGINS \"*\"\nlaunchctl setenv OLLAMA_HOST \"0.0.0.0\"\n```","pinCode":false,"dname":"0ff53b13-dc2b-4b51-b008-db85a6770909","codeMode":"markdown"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof query = Inputs.text({label: \"Query\", value: \"Who was kind and adventurous?\"})","pinCode":false,"dname":"78090254-de36-4e5d-9c07-83bf777521bd","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"Button(\"Run\", async () => {\n  const vector = await gxr.embed(query, {provider: \"ollama\"});\n  const cypher = `LOAD VECTOR; CALL QUERY_VECTOR_INDEX(\n        'ObservationTextVector',\n        'observation_text_vector_index',\n        [${vector}],\n        10\n    )\n    WITH node AS n, distance\n    MATCH (n)--(observation:Observation)\n    RETURN observation, distance\n    ORDER BY distance LIMIT 5`;\n  const result = await gxr.neo4j(cypher, {saveToGraph: false});\n  mutable context = result._content.data;\n  const response = await gxr.ask(`Who was kind and adventurous? Context: ${JSON.stringify(result._content.data)}`, {\n    model: \"gemma3\",\n    config: {\n      provider: \"ollama\",\n      isLocal: true,\n      baseUrl: \"http://localhost:11434\"\n    }\n  });\n  console.log(response);\n  if (typeof response == \"string\") {\n    mutable answer = response;\n  } else if (typeof response == \"object\" && response.content) {\n    mutable answer = response.content; \n  }\n});","pinCode":false,"dname":"796d2f42-6867-423c-ae66-80cd6a388150","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"## Context","pinCode":false,"dname":"5029ab29-66f6-45a3-b54b-def9d1d78808","codeMode":"markdown"}}},{"type":"codeTool","data":{"codeData":{"value":"Inputs.table(\n  context.slice(1).map(([node, distance]) => ({distance, node: JSON.stringify(node),}))\n  )","pinCode":false,"dname":"eabe0e07-3cc7-467e-80fd-0bbcf3ae352d","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"mutable context = []","pinCode":false,"dname":"0463125d-1278-451d-b04e-9a23921a3f7e","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"## Answer","pinCode":false,"dname":"84eff0fd-644d-4985-9afd-83fc5819c6a5","codeMode":"markdown"}}},{"type":"codeTool","data":{"codeData":{"value":"md`${answer}`","pinCode":false,"dname":"de43037f-81f8-4b85-bfec-d9ab4cacdaa0","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"mutable answer = `ℹ️ Click the Run button to generate an answer`;","pinCode":false,"dname":"b0ba1a5c-b43b-40dd-8c87-f0d46f0aa10e","codeMode":"javascript2","hide":true}}}],"version":"2.19.1"}
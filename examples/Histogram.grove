{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"md`# Data comes from canvas`","pinCode":false,"dname":"479e731c-181a-4ab3-a314-422bc713a04c","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof groupBy = Inputs.select([\"Day\", \"Month\"], { value: \"Month\" })","pinCode":false,"dname":"a99bc110-fd78-4f18-a56a-be16fdb1ef91","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"barChartData = {\n  // Get all nodes\n  const nodes = graph\n    .nodes()\n    .values()\n    .filter((n) => n.category == \"Message\");\n  // Helper to extract 'YYYY-MM' from ISO date\n  function getMonth(dateStr) {\n    return dateStr.slice(0, 7);\n    // \"YYYY-MM\"\n  }\n  function getDay(dateStr) {\n    return dateStr.slice(8, 10);\n  }\n  // Gather all unique tags\n  const uniqueTags = new Set();\n  for (const node of nodes) {\n    for (const tag of node.tags) {\n      uniqueTags.add(tag);\n    }\n  }\n  const tagList = Array.from(uniqueTags);\n  // Group and count\n  const map = new Map();\n  for (const node of nodes) {\n    const groupValue =\n      groupBy == \"Month\"\n        ? getMonth(node.properties.datetime)\n        : getDay(node.properties.datetime);\n    if (!map.has(groupValue)) {\n      // Initialize group object with all tags set to 0\n      const groupObj = { group: groupValue };\n      for (const tag of tagList) {\n        groupObj[tag] = 0;\n      }\n      map.set(groupValue, groupObj);\n    }\n    const groupObj = map.get(groupValue);\n    for (const tag of node.tags) {\n      groupObj[tag]++;\n    }\n  }\n  // Convert map to array and sort by groupValue (ascending)\n  const data = Array.from(map.values()).sort((a, b) =>\n    a.group.localeCompare(b.group)\n  );\n  return { data, tagList };\n}","pinCode":false,"dname":"739bb1da-00bf-4900-829e-f2246d8d6218","codeMode":"javascript2","hide":true}}},{"type":"codeTool","data":{"codeData":{"value":"chart = {\n  const { data, tagList: keys } = barChartData;\n  //   const width = 800;\n  const height = 800;\n  const margin = { top: 30, right: 30, bottom: 70, left: 60 };\n  const series = d3.stack().keys(keys)(data);\n  const x = d3\n    .scaleBand()\n    .domain(data.map((d) => d.group))\n    .range([margin.left, width - margin.right])\n    .padding(0.1);\n  const y = d3\n    .scaleLinear()\n    .domain([0, d3.max(data, (d) => d3.sum(keys, (key) => d[key]))])\n    .nice()\n    .range([height - margin.bottom, margin.top]);\n  const color = d3\n    .scaleOrdinal()\n    .domain(keys)\n    .range(d3.schemeTableau10.concat(d3.schemeSet3));\n  // More colors\n  const svg = d3\n    .create(\"svg\")\n    .attr(\"viewBox\", [0, 0, width, height])\n    .attr(\"width\", width)\n    .attr(\"height\", height)\n    .attr(\"style\", \"background: #fff; max-width: 100%; height: auto;\");\n  // Gridlines\n  svg\n    .append(\"g\")\n    .attr(\"stroke\", \"#eee\")\n    .selectAll(\"line\")\n    .data(y.ticks())\n    .join(\"line\")\n    .attr(\"x1\", margin.left)\n    .attr(\"x2\", width - margin.right)\n    .attr(\"y1\", y)\n    .attr(\"y2\", y);\n  // Draw stacked bars with white stroke\n  svg\n    .append(\"g\")\n    .selectAll(\"g\")\n    .data(series)\n    .join(\"g\")\n    .attr(\"fill\", (d) => color(d.key))\n    .selectAll(\"rect\")\n    .data((d) => d)\n    .join(\"rect\")\n    .attr(\"x\", (d) => x(d.data.group))\n    .attr(\"y\", (d) => y(d[1]))\n    .attr(\"height\", (d) => y(d[0]) - y(d[1]))\n    .attr(\"width\", x.bandwidth())\n    .attr(\"stroke\", \"#fff\")\n    .on(\"mouseover\", function (event, d) {\n      d3.select(this).attr(\"opacity\", 0.7);\n      // Tooltip logic here (optional)\n    })\n    .on(\"mouseout\", function () {\n      d3.select(this).attr(\"opacity\", 1);\n    })\n    .on(\"click\", function (event, d) {\n      // Find the key for this segment\n      const key = d3.select(this.parentNode).datum().key;\n      const group = d.data.group;\n      // This is the x-axis group value\n      // Log group, key, and value\n      const tag = key;\n      const count = d.data[key];\n      // Filtering logic\n      const ids = gxr\n        .nodes()\n        .values()\n        .filter((n) => n.tags.includes(tag))\n        .filter((n) => {\n          if (groupBy == \"Month\") {\n            const groupValue = n.properties.datetime.slice(0, 7);\n            return groupValue === group;\n          } else if (groupBy == \"Day\") {\n            const groupValue = n.properties.datetime.slice(8, 10);\n            return groupValue === group;\n          }\n          return false;\n        });\n      console.log({ group, key, count, ids });\n      gxr.nodes(ids).select();\n    })// X axis with rotated labels\n  svg\n    .append(\"g\")\n    .attr(\"transform\", `translate(0,${height - margin.bottom})`)\n    .call(d3.axisBottom(x))\n    .selectAll(\"text\")\n    .attr(\"transform\", \"rotate(-45)\")\n    .attr(\"text-anchor\", \"end\")\n    .attr(\"fill\", \"black\");\n  // Y axis\n  svg\n    .append(\"g\")\n    .attr(\"transform\", `translate(${margin.left},0)`)\n    .call(d3.axisLeft(y))\n    .selectAll(\"text\")\n    .attr(\"fill\", \"black\");\n  // Axis labels\n  svg\n    .append(\"text\")\n    .attr(\"x\", width / 2)\n    .attr(\"y\", height - 5)\n    .attr(\"text-anchor\", \"middle\")\n    .attr(\"font-size\", 14)\n    .text(groupBy);\n  svg\n    .append(\"text\")\n    .attr(\"transform\", \"rotate(-90)\")\n    .attr(\"x\", -height / 2)\n    .attr(\"y\", 20)\n    .attr(\"text-anchor\", \"middle\")\n    .attr(\"font-size\", 14)\n    .attr(\"fill\", \"black\")\n    .text(\"Count\");\n  // Legend (vertical, top right)\n  const legend = svg\n    .append(\"g\")\n    .attr(\"font-family\", \"sans-serif\")\n    .attr(\"font-size\", 12)\n    .attr(\"text-anchor\", \"start\")\n    .attr(\n      \"transform\",\n      `translate(${width - margin.right - 300},${margin.top})`\n    );\n  // Adjust 140 to fit your legend width\n  const legendItem = legend\n    .selectAll(\"g\")\n    .data(keys)\n    .join(\"g\")\n    .attr(\"transform\", (d, i) => `translate(0,${i * 22})`);\n  // 22px spacing\n  legendItem\n    .append(\"rect\")\n    .attr(\"width\", 18)\n    .attr(\"height\", 18)\n    .attr(\"fill\", (d) => color(d));\n  legendItem\n    .append(\"text\")\n    .attr(\"x\", 24)\n    .attr(\"y\", 13)\n    .text((d) => d);\n  return svg.node();\n}","pinCode":false,"dname":"cc31013c-1ab9-413b-9921-a6fd1310545e","codeMode":"javascript2"}}}],"version":"2.19.1"}